---
import { MY_EMAIL, MY_GITHUB, MY_LINKEDIN } from "@/utils/constants";
import { EmailIcon, GithubIcon, LinkedInIcon } from "@/utils/icons";
import SocialLinks from "./SocialLinks.astro";

interface NavItem {
  href: string;
  label: string;
  id: string;
}

interface Props {
  navItems: NavItem[];
  footerText: string;
  connectText: string;
}

const { navItems, footerText, connectText } = Astro.props;

const socialLinks = [
  { href: `mailto:${MY_EMAIL}`, icon: EmailIcon, label: MY_EMAIL },
  {
    href: `https://linkedin.com/in/${MY_LINKEDIN}`,
    icon: LinkedInIcon,
    label: `LinkedIn: ${MY_LINKEDIN}`,
  },
  {
    href: `https://github.com/${MY_GITHUB}`,
    icon: GithubIcon,
    label: `GitHub: ${MY_GITHUB}`,
  },
];

const currentYear = new Date().getFullYear();
---

<div
  data-mobile-menu
  aria-hidden="true"
  class="md:hidden overflow-y-auto fixed inset-0 top-[73px] bg-bg flex flex-col h-[75vh] transform rounded-b-4xl border-b-2 border-primary/50 transition-all duration-700 ease-in-out -translate-y-full opacity-90 pointer-events-none data-[mobile-open=true]:translate-y-0 data-[mobile-open=true]:opacity-100 data-[mobile-open=true]:pointer-events-auto"
>
  <nav class="container mx-auto px-4 pt-8 flex flex-col">
    {navItems.map((item) => (
      <a
        href={item.href}
        data-nav-link
        data-id={item.id}
        data-active="false"
        class="py-4 px-4 text-lg font-medium border-l-4 mb-2 transition-all duration-200 border-transparent hover:border-primary/50 hover:bg-fg-alt/5 data-[active=true]:border-primary data-[active=true]:bg-primary/10 data-[active=true]:text-primary"
      >
        {item.label}
      </a>
    ))}
  </nav>

  <!-- Social Links Section -->
  <div class="my-auto p-4">
    <h3 class="text-lg font-medium px-4 mb-4 text-fg-alt">{connectText}</h3>
    <div class="mx-4">
      <p class="-mt-2 border-t-2 border-primary/80"></p>
    </div>
    <SocialLinks links={socialLinks} />
  </div>

  <!-- Footer -->
  <div
    class="my-auto p-4 border-t border-secondary text-center text-fg-alt text-sm"
  >
    <p class="text-fg-alt text-sm mb-4 md:mb-0">
      &copy; {`${currentYear} ${footerText}`}
    </p>
  </div>
</div>