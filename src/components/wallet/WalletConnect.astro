---
import { getLangFromUrl } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
---

<div class="wallet-connect" data-wallet-connect data-lang={lang}></div>

<script>
  import { useTranslations } from "@/i18n/utils";
  import {
    checkConnection,
    connectWallet,
    disconnectWallet,
    getWalletState,
    shortenAddress,
    subscribeWallet,
  } from "@/utils/useWallet";

  const mount = document.querySelector<HTMLElement>("[data-wallet-connect]");

  if (!mount) {
    throw new Error("Wallet connect mount element not found");
  }

  const t = useTranslations(mount.getAttribute("data-lang") ?? "en");

  let showDropdown = false;

  const chevronDownIcon = `
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-4 h-4">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  `;

  const logoutIcon = `
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4">
      <path d="M14 8v-2a2 2 0 0 0 -2 -2h-7a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h7a2 2 0 0 0 2 -2v-2" />
      <path d="M9 12h12l-3 -3" />
      <path d="M18 15l3 -3" />
    </svg>
  `;

  const escapeHtml = (value: string): string =>
    value.replace(
      /[&<>"']/g,
      (char) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[
          char
        ] ?? char,
    );

  const connectTemplate = (): string => `
    <button
      data-wallet-connect-button
      class="flex items-center gap-2 px-4 py-2 text-bg bg-gradient-to-r from-secondary to-tertiary rounded-full border-2 border-primary/50 hover:scale-105 transition-all duration-300 hover:shadow-xl"
    >
      <div class="w-3 h-3 rounded-full bg-bg"></div>
      <span>${escapeHtml(t("wallet.connect"))}</span>
    </button>
  `;

  const connectedTemplate = (): { dropdown: string; toggle: string } => {
    const {
      isConnected,
      account,
      networkInfo,
      balance,
    } = getWalletState();

    if (!isConnected || !networkInfo) {
      return { dropdown: "", toggle: "" };
    }

    const dropdown = showDropdown
      ? `
          <div class="absolute -left-10 mt-2 w-64 rounded-md shadow-lg bg-bg-secondary border border-fg-alt/10 overflow-hidden z-10">
            <div class="p-3 border-b border-fg-alt/10">
              <p class="text-base text-fg-alt font-bold">${escapeHtml(t("wallet.connected"))}</p>
            </div>
            <div class="p-3 space-y-1 text-sm">
              <div class="flex justify-between">
                <span class="text-fg-alt font-semibold">${escapeHtml(t("wallet.chainId"))}: </span>
                <span class="font-medium">${escapeHtml(networkInfo.chainId)}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-fg-alt font-semibold">${escapeHtml(t("wallet.network"))}: </span>
                <span class="font-medium">${escapeHtml(networkInfo.chainName)}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-fg-alt font-semibold">${escapeHtml(t("wallet.balance"))}: </span>
                <span class="font-medium">${escapeHtml(balance ?? "")} ${escapeHtml(networkInfo.tokenSymbol)}</span>
              </div>
            </div>
            <button
              data-wallet-disconnect
              class="w-full p-3 text-red-500 hover:bg-red-50 dark:hover:bg-red-900/50 transition-colors flex items-center gap-2"
            >
              ${logoutIcon}
              ${escapeHtml(t("wallet.disconnect"))}
            </button>
          </div>
        `
      : "";

    const toggle = `
      <button
        data-wallet-toggle
        class="flex items-center gap-2 px-4 py-2 bg-accent/70 rounded-full transition-all duration-300 hover:shadow-md group ${showDropdown ? "" : "hover:bg-accent/40"}"
      >
        <div class="w-3 h-3 rounded-full bg-green-500"></div>
        <span class="font-medium">${escapeHtml(shortenAddress(account))}</span>
        <span class="w-4 h-4 transition-transform ${showDropdown ? "rotate-180" : ""}">${chevronDownIcon}</span>
      </button>
    `;

    return { dropdown, toggle };
  };

  const render = (): void => {
    const { isConnected, networkInfo, clientHasWallet } = getWalletState();

    if (!clientHasWallet) {
      mount.innerHTML = "";
      return;
    }

    if (isConnected && networkInfo) {
      const { dropdown, toggle } = connectedTemplate();
      mount.innerHTML = `
        <div class="relative">
          ${toggle}
          ${dropdown}
        </div>
      `;
    } else {
      mount.innerHTML = connectTemplate();
    }

    bindEvents();
  };

  const bindEvents = (): void => {
    mount
      .querySelector<HTMLButtonElement>("[data-wallet-connect-button]")
      ?.addEventListener("click", () => {
        void connectWallet().then((connected) => {
          if (!connected && !window.ethereum) {
            window.alert(t("wallet.no_ethereum_provider"));
          }
        });
      });

    mount
      .querySelector<HTMLButtonElement>("[data-wallet-toggle]")
      ?.addEventListener("click", () => {
        showDropdown = !showDropdown;
        render();
      });

    mount
      .querySelector<HTMLButtonElement>("[data-wallet-disconnect]")
      ?.addEventListener("click", () => {
        showDropdown = false;
        void disconnectWallet();
      });
  };

  document.addEventListener(
    "click",
    (event) => {
      const target = event.target as Node | null;
      if (target && !mount.contains(target)) {
        showDropdown = false;
        render();
      }
    },
    true,
  );

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && showDropdown) {
      showDropdown = false;
      render();
    }
  });

  subscribeWallet(render);
  void checkConnection();
  render();
</script>