---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { MoonIcon, SunIcon, SystemIcon } from "@/utils/icons";
import ToggleDropDown from "./ToggleDropDown.astro";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<ToggleDropDown buttonAriaLabel="Toggle theme">
  <span slot="button-content" class="contents">
    <SunIcon class="w-8 h-8 md:w-5 md:h-5 hidden" data-theme-icon="light" />
    <MoonIcon class="w-8 h-8 md:w-5 md:h-5 hidden" data-theme-icon="dark" />
    <SystemIcon class="w-8 h-8 md:w-5 md:h-5" data-theme-icon="system" />
  </span>

  <button
    type="button"
    data-theme="light"
    class="flex items-center w-full px-4 py-2 text-sm hover:bg-primary/10 dark:hover:bg-primary/40"
  >
    <SunIcon class="h-4 w-4 mr-2" />
    {t("theme.light")}
  </button>
  <button
    type="button"
    data-theme="dark"
    class="flex items-center w-full px-4 py-2 text-sm hover:bg-primary/10 dark:hover:bg-primary/40"
  >
    <MoonIcon class="h-4 w-4 mr-2" />
    {t("theme.dark")}
  </button>
  <button
    type="button"
    data-theme="system"
    class="flex items-center w-full px-4 py-2 text-sm hover:bg-primary/10 dark:hover:bg-primary/40"
  >
    <SystemIcon class="h-4 w-4 mr-2" />
    {t("theme.system")}
  </button>
</ToggleDropDown>

<script>
  import {
    THEME_STORAGE_KEY,
    type ThemePreference,
    isDarkTheme,
    readThemePreference,
  } from "@/utils/theme";

  const indicators = document.querySelectorAll("[data-theme-icon]");
  const themeButtons = document.querySelectorAll("[data-theme]");
  const systemDarkQuery = window.matchMedia("(prefers-color-scheme: dark)");

  const currentPreference = (): ThemePreference => {
    try {
      return readThemePreference(localStorage.getItem(THEME_STORAGE_KEY));
    } catch {
      return "system";
    }
  };

  const applyTheme = (preference: ThemePreference) => {
    document.documentElement.classList.toggle(
      "dark",
      isDarkTheme(preference, systemDarkQuery.matches),
    );
  };

  const updateThemeUI = () => {
    const current = currentPreference();
    indicators.forEach((icon) => {
      icon.classList.toggle(
        "hidden",
        icon.getAttribute("data-theme-icon") !== current,
      );
    });
    themeButtons.forEach((button) => {
      button.classList.toggle(
        "text-secondary",
        button.getAttribute("data-theme") === current,
      );
    });
  };

  updateThemeUI();

  themeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const preference = readThemePreference(button.getAttribute("data-theme"));

      applyTheme(preference);
      try {
        localStorage.setItem(THEME_STORAGE_KEY, preference);
      } catch {
        // Storage can be unavailable (private mode); the theme still applies.
      }
      updateThemeUI();

      const dropdown = button.closest("[data-dropdown]");
      const panel = dropdown?.querySelector("[data-dropdown-panel]");
      panel?.classList.add("hidden");
    });
  });

  // Keep following the OS while "system" is selected.
  systemDarkQuery.addEventListener("change", () => {
    if (currentPreference() === "system") applyTheme("system");
  });
</script>
