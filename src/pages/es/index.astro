---
import "@/styles/global.css";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const _t = useTranslations(lang);
---

<Layout title={t("site.title")} description={t("site.description")} lang={lang} keywords={t("site.keywords")}>
  <div class="relative">
    <BlockchainCanvas client:load client:only="canvas" />
    <Hero client:load client:only="hero" />
  </div>
  <About />
  <Skills />
  <Projects />
  <!-- <Certificates /> Better inside BackgroundPreview section -->
  <BackgroundPreview />
  <Languages />
  <Contact />
</Layout>
