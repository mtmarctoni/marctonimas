{
  "name": "marctonimas",
  "type": "module",
  "version": "0.0.1",
  "author": "mtmarctoni",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "biome check src/",
    "lint:fix": "biome check --write --unsafe src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "typecheck": "astro sync && tsc --noEmit",
    "check": "astro check",
    "check:all": "pnpm run lint && pnpm run typecheck && pnpm run check && pnpm run test && pnpm run build && pnpm run knip && pnpm run depcruise",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "depcruise": "depcruise src",
    "audit": "pnpm audit",
    "prepare": "husky",
    "lighthouse": "lhci autorun",
    "a11y": "pa11y-ci"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.3.2",
    "ethers": "^6.13.5",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/vite": "^4.0.13",
    "@vitest/coverage-v8": "^4.1.8",
    "dependency-cruiser": "^18.2.0",
    "husky": "^9.1.7",
    "knip": "^6.16.1",
    "lint-staged": "^17.0.7",
    "pa11y-ci": "^4.1.1",
    "puppeteer": "^25.1.0",
    "tailwindcss": "^4.0.13",
    "vitest": "^4.1.8",
    "wait-on": "^9.1.0"
  },
  "lint-staged": {
    "*.{js,ts,astro}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{json,md,yml,yaml}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "knip": {
    "entry": [
      "src/**/*.astro",
      "src/**/*.ts",
      "src/**/*.js"
    ],
    "project": [
      "src/**/*.astro",
      "src/**/*.ts",
      "src/**/*.js"
    ],
    "ignoreDependencies": [
      "tailwindcss"
    ]
  }
}
