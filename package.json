{
  "name": "marctonimas",
  "type": "module",
  "version": "0.0.1",
  "author": "mtmarctoni",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "biome check src/",
    "lint:fix": "biome check --write --unsafe src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "typecheck": "astro sync && tsc --noEmit",
    "check": "astro check",
    "check:all": "pnpm run lint && pnpm run typecheck && pnpm run check && pnpm run test && pnpm run build && pnpm run knip && pnpm run depcruise",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "depcruise": "depcruise src",
    "audit": "pnpm audit",
    "doctor": "astro-doctor",
    "prepare": "husky",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "astro": "^7.3.8",
    "ethers": "^6.17.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@lhci/cli": "^0.16.0",
    "@santi020k/astro-doctor": "^1.7.0",
    "@tailwindcss/vite": "^4.3.4",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "tailwindcss": "^4.3.4",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,ts,astro}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{json,md,yml,yaml}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  }
}
