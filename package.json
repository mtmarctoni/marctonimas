{
  "name": "marctonimas",
  "type": "module",
  "version": "0.0.1",
  "author": "mtmarctoni",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "biome check src/",
    "lint:fix": "biome check --write --unsafe src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "typecheck": "tsc --noEmit",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "audit": "pnpm audit",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/vue": "^5.1.0",
    "astro": "^5.10.1",
    "ethers": "^6.13.5",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@tailwindcss/vite": "^4.0.13",
    "@vitest/coverage-v8": "^4.1.8",
    "husky": "^9.1.7",
    "knip": "^6.16.1",
    "lint-staged": "^17.0.7",
    "tailwindcss": "^4.0.13",
    "vite-svg-loader": "^5.1.0",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*.{js,ts,vue,astro}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{json,md,yml,yaml}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "knip": {
    "entry": [
      "src/**/*.astro",
      "src/**/*.ts",
      "src/**/*.vue"
    ],
    "project": [
      "src/**/*.astro",
      "src/**/*.ts",
      "src/**/*.vue"
    ]
  }
}
